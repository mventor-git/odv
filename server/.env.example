# odv server environment (loaded via dotenv at boot).
# JWT_SECRET is auto-generated and persisted to .env on first boot if absent.
# You may set it explicitly here instead (>=32 chars, random):
# JWT_SECRET=your-long-random-secret-here
JWT_TTL=12h
PORT=8050
# DATA_DIR=./data
# FILES_DIR=./data/pdfs
# VAULT_DIR=./data/vault
# WORK_DIR=./data/work
# SCANS_DIR=./data/scans-watch
# ADMIN_PASSWORD=
